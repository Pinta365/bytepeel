# libFuzzer dictionary for bytepeel: magic bytes, headers and tokens that random
# mutation rarely assembles. Use with: cargo +nightly fuzz run <target> -- -dict=dict/bytepeel.dict

# Multi-byte UTF-8 (2, 3 and 4 bytes) and a lone continuation byte
utf8_2="\xc3\xa9"
utf8_3="\xe2\x82\xac"
utf8_4="\xf0\x9f\x98\x80"
utf8_cont="\x80"

# DER: SEQUENCE headers, long-form lengths, time tags with lengths, OIDs
der_seq="\x30\x82"
der_seq_short="\x30\x0d"
der_len_81="\x81"
der_len_82="\x82\x01\x00"
der_utctime="\x17\x0d"
der_gentime="\x18\x0f"
der_oid_cn="\x06\x03\x55\x04\x03"
der_oid_rsa="\x06\x09\x2a\x86\x48\x86\xf7\x0d\x01\x01\x01"
der_null="\x05\x00"
der_bitstring="\x03\x02\x00"
der_octet="\x04\x14"
der_ctx0="\xa0\x03"
der_indef="\x30\x80"
time_z="Z"
time_plus="+0200"
time_minus="-0530"
time_frac=".123"
utc_time="261112093000Z"
gen_time="20261112093000Z"

# Compression magics
gzip="\x1f\x8b\x08\x00"
gzip_fname="\x1f\x8b\x08\x08"
zstd="\x28\xb5\x2f\xfd"
zlib="\x78\x9c"
zlib_1="\x78\x01"

# CBOR
cbor_selfdesc="\xd9\xd9\xf7"
cbor_tag24="\xd8\x18"
cbor_tag1="\xc1"
cbor_bignum="\xc2\x49"
cbor_uuid="\xd8\x25\x50"
cbor_indef_bytes="\x5f"
cbor_indef_map="\xbf"
cbor_break="\xff"
cbor_half="\xf9"
cbor_float="\xfa"
cbor_double="\xfb"
cbor_u64="\x1b"

# MessagePack
mp_reserved="\xc1"
mp_bin8="\xc4"
mp_str8="\xd9"
mp_array32="\xdd"
mp_map16="\xde"
mp_ts32="\xd6\xff"
mp_ts64="\xd7\xff"
mp_ts96="\xc7\x0c\xff"
mp_u64="\xcf"
mp_i64="\xd3"

# Protobuf
pb_len1="\x0a"
pb_varint2="\x10"
pb_i64="\x09"
pb_i32="\x15"
pb_group="\x0b"
pb_endgroup="\x0c"
pb_varint_max="\xff\xff\xff\xff\xff\xff\xff\xff\xff\x01"

# Text layers
pem_begin="-----BEGIN "
pem_end="-----END "
pem_cert="CERTIFICATE-----"
pem_key="PRIVATE KEY-----"
jwt_hdr="eyJhbGciOiJIUzI1NiJ9."
jwt_none="eyJhbGciOiJub25lIn0."
hex_0x="0x"
b64_pad="=="
b64_url="-_"
xxd_line="00000000: "
xxd_line2="00000010: "
hexdump_line="00000000  "
hexdump_bar="|"
hexdump_star="*"
json_exp="\"exp\":"
json_iat="\"iat\":"
